<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ODDORA GAMES</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #080b16;
      color: white;
      min-height: 100vh;
    }

    header {
      padding: 25px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #10152a;
      border-bottom: 1px solid #252c4a;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
      font-size: 15px;
    }

    .hero {
      padding: 80px 6%;
      text-align: center;
      background:
        radial-gradient(circle at top, #29347a, transparent 45%),
        #080b16;
    }

    .hero h1 {
      font-size: clamp(42px, 8vw, 80px);
      margin-bottom: 15px;
    }

    .hero p {
      color: #b8bfdc;
      font-size: 18px;
      margin-bottom: 30px;
    }

    .button {
      display: inline-block;
      padding: 14px 28px;
      border-radius: 12px;
      background: #6c63ff;
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    .games {
      padding: 45px 6%;
    }

    .games h2 {
      margin-bottom: 25px;
      font-size: 30px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: #11172b;
      border: 1px solid #252c4a;
      border-radius: 18px;
      padding: 25px;
      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #6c63ff;
    }

    .game-icon {
      font-size: 55px;
      margin-bottom: 15px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #9da5c7;
      margin-bottom: 20px;
      line-height: 1.6;
    }

    .play {
      border: 0;
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      background: #6c63ff;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    footer {
      text-align: center;
      padding: 35px;
      color: #777f9f;
      border-top: 1px solid #202640;
      margin-top: 30px;
    }

    #gameArea {
      display: none;
      padding: 30px 6%;
      text-align: center;
    }

    #gameBox {
      max-width: 500px;
      margin: 20px auto;
      padding: 35px;
      background: #11172b;
      border-radius: 18px;
      border: 1px solid #252c4a;
    }

    #number {
      font-size: 70px;
      margin: 25px;
    }

    .close {
      background: #333b5c;
      margin-top: 10px;
    }
  </style>
</head>

<body>

<header>
  <div class="logo">ODDORA</div>

  <nav>
    <a href="#games">الألعاب</a>
    <a href="#about">عن الموقع</a>
  </nav>
</header>

<section class="hero">
  <h1>ODDORA GAMES</h1>
  <p>ألعاب بسيطة وسريعة وممتعة للجميع</p>
  <a class="button" href="#games">ابدأ اللعب</a>
</section>

<section class="games" id="games">
  <h2>الألعاب</h2>

  <div class="grid">

    <div class="card">
      <div class="game-icon">🎯</div>
      <h3>اختبار السرعة</h3>
      <p>اضغط بأسرع ما تستطيع وسجل أفضل نتيجة.</p>
      <button class="play" onclick="startSpeedGame()">العب الآن</button>
    </div>

    <div class="card">
      <div class="game-icon">🔢</div>
      <h3>خمن الرقم</h3>
      <p>حاول معرفة الرقم السري بأقل عدد من المحاولات.</p>
      <button class="play" onclick="startGuessGame()">العب الآن</button>
    </div>

    <div class="card">
      <div class="game-icon">🧠</div>
      <h3>تحدي الذاكرة</h3>
      <p>اختبر ذاكرتك وحاول الوصول إلى أعلى نتيجة.</p>
      <button class="play" onclick="startMemoryGame()">العب الآن</button>
    </div>

  </div>
</section>

<section id="gameArea">
  <div id="gameBox"></div>
</section>

<section class="games" id="about">
  <h2>عن ODDORA</h2>
  <p style="color:#9da5c7;line-height:1.8;">
    ODDORA منصة ألعاب ويب نعمل على تطويرها لتصبح مكانًا
    يجمع ألعابًا سريعة وممتعة للاعبين من مختلف الدول.
  </p>
</section>

<footer>
  © 2026 ODDORA GAMES
</footer>

<script>

function showGame(html) {
  const area = document.getElementById("gameArea");
  const box = document.getElementById("gameBox");

  box.innerHTML = html;
  area.style.display = "block";
  area.scrollIntoView({ behavior: "smooth" });
}

function closeGame() {
  document.getElementById("gameArea").style.display = "none";
}

function startSpeedGame() {

  showGame(`
    <h2>اختبار السرعة</h2>
    <p>انتظر حتى يظهر "اضغط!" ثم اضغط بسرعة.</p>
    <div id="speedText" style="font-size:35px;margin:30px;">انتظر...</div>
    <button class="play" id="speedButton" disabled>اضغط!</button>
    <button class="play close" onclick="closeGame()">إغلاق</button>
  `);

  const text = document.getElementById("speedText");
  const button = document.getElementById("speedButton");

  const delay = Math.floor(Math.random() * 3000) + 2000;

  setTimeout(() => {
    text.textContent = "اضغط!";
    button.disabled = false;

    const start = Date.now();

    button.onclick = function() {
      const time = Date.now() - start;
      text.textContent = "نتيجتك: " + time + " ms";
      button.disabled = true;
    };

  }, delay);
}

function startGuessGame() {

  const secret = Math.floor(Math.random() * 100) + 1;

  showGame(`
    <h2>خمن الرقم</h2>
    <p>اختر رقمًا من 1 إلى 100</p>

    <input
      id="guessInput"
      type="number"
      min="1"
      max="100"
      style="padding:14px;width:100%;margin:20px 0;border-radius:10px;border:0;font-size:18px;"
    >

    <button class="play" onclick="checkGuess(${secret})">
      تخمين
    </button>

    <div id="guessResult" style="margin:20px;font-size:20px;"></div>

    <button class="play close" onclick="closeGame()">إغلاق</button>
  `);
}

function checkGuess(secret) {

  const input = document.getElementById("guessInput");
  const result = document.getElementById("guessResult");

  const value = Number(input.value);

  if (!value) {
    result.textContent = "اكتب رقمًا أولًا.";
    return;
  }

  if (value === secret) {
    result.textContent = "أحسنت! لقد وجدت الرقم.";
  } else if (value < secret) {
    result.textContent = "الرقم أكبر.";
  } else {
    result.textContent = "الرقم أصغر.";
  }
}

function startMemoryGame() {

  showGame(`
    <h2>تحدي الذاكرة</h2>
    <p>احفظ الرقم الذي سيظهر أمامك.</p>

    <div id="number">---</div>

    <button class="play" onclick="memoryStart()">ابدأ</button>

    <button class="play close" onclick="closeGame()">إغلاق</button>
  `);
}

function memoryStart() {

  const number = Math.floor(Math.random() * 9000) + 1000;

  document.getElementById("number").textContent = number;

  setTimeout(() => {

    document.getElementById("number").textContent = "؟";

    const answer = prompt("ما الرقم الذي ظهر؟");

    if (answer == number) {
      alert("إجابة صحيحة!");
    } else {
      alert("إجابة خاطئة. الرقم كان: " + number);
    }

  }, 2000);
}

</script>

</body>
</html>
