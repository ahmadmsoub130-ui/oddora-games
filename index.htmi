<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="ODDORA Games - ألعاب مجانية ممتعة للجميع">
  <title>ODDORA Games</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background:
        radial-gradient(circle at top, #172554 0%, #070b18 45%, #02040b 100%);
      color: white;
      min-height: 100vh;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(15px);
      background: rgba(3, 7, 18, 0.82);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .nav {
      max-width: 1200px;
      margin: auto;
      padding: 18px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 27px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #7dd3fc;
      text-shadow: 0 0 20px rgba(56,189,248,.7);
    }

    .nav button {
      border: 0;
      padding: 10px 18px;
      border-radius: 25px;
      background: linear-gradient(135deg,#38bdf8,#6366f1);
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    .hero {
      max-width: 1200px;
      margin: auto;
      padding: 75px 20px 45px;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(45px, 10vw, 90px);
      font-weight: 900;
      background: linear-gradient(90deg,#38bdf8,#a78bfa,#f472b6);
      -webkit-background-clip: text;
      color: transparent;
      margin-bottom: 15px;
    }

    .hero p {
      color: #cbd5e1;
      font-size: 19px;
      max-width: 650px;
      margin: auto;
      line-height: 1.8;
    }

    .games {
      max-width: 1200px;
      margin: auto;
      padding: 20px;
    }

    .section-title {
      font-size: 28px;
      margin-bottom: 25px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
      gap: 22px;
    }

    .card {
      background: rgba(15,23,42,.75);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 22px;
      padding: 25px;
      min-height: 240px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 15px 40px rgba(0,0,0,.25);
      transition: .25s;
    }

    .card:hover {
      transform: translateY(-7px);
      border-color: rgba(56,189,248,.6);
      box-shadow: 0 20px 50px rgba(14,165,233,.15);
    }

    .icon {
      font-size: 55px;
      margin-bottom: 15px;
    }

    .card h3 {
      font-size: 23px;
      margin-bottom: 8px;
    }

    .card p {
      color: #94a3b8;
      line-height: 1.6;
    }

    .play {
      margin-top: 20px;
      width: 100%;
      padding: 13px;
      border: 0;
      border-radius: 14px;
      background: linear-gradient(135deg,#2563eb,#7c3aed);
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .play:hover {
      filter: brightness(1.15);
    }

    .game-area {
      display: none;
      max-width: 900px;
      margin: 30px auto;
      padding: 20px;
    }

    .game-box {
      background: rgba(15,23,42,.9);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 25px;
      padding: 30px;
      text-align: center;
    }

    .back {
      border: 0;
      background: #334155;
      color: white;
      padding: 10px 18px;
      border-radius: 12px;
      cursor: pointer;
      margin-bottom: 20px;
    }

    #gameTitle {
      font-size: 32px;
      margin-bottom: 20px;
    }

    .score {
      font-size: 22px;
      margin: 15px;
      color: #7dd3fc;
    }

    .big-button {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      border: 0;
      background: linear-gradient(135deg,#06b6d4,#6366f1);
      color: white;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 0 45px rgba(59,130,246,.4);
      margin: 25px;
    }

    .big-button:active {
      transform: scale(.94);
    }

    .number {
      font-size: 70px;
      font-weight: 900;
      margin: 20px;
      color: #f472b6;
    }

    .answer {
      padding: 13px 22px;
      margin: 6px;
      border: 0;
      border-radius: 12px;
      background: #1e293b;
      color: white;
      cursor: pointer;
      font-size: 17px;
    }

    footer {
      text-align: center;
      color: #64748b;
      padding: 50px 20px 30px;
      margin-top: 40px;
    }

    @media(max-width:600px) {
      .hero {
        padding-top: 50px;
      }

      .card {
        min-height: 220px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="nav">
    <div class="logo">ODDORA</div>
    <button onclick="scrollToGames()">الألعاب</button>
  </div>
</header>

<section class="hero">
  <h1>ODDORA GAMES</h1>
  <p>
    عالم ألعاب مجاني وسريع وممتع.
    العب من هاتفك أو الكمبيوتر بدون تحميل.
  </p>
</section>

<section class="games" id="games">
  <h2 class="section-title">🎮 الألعاب</h2>

  <div class="grid">

    <div class="card">
      <div>
        <div class="icon">⚡</div>
        <h3>اضغط بسرعة</h3>
        <p>كم مرة تستطيع الضغط خلال الوقت المحدد؟</p>
      </div>
      <button class="play" onclick="startGame('clicker')">
        العب الآن
      </button>
    </div>

    <div class="card">
      <div>
        <div class="icon">🧠</div>
        <h3>اختبار الرقم</h3>
        <p>اختر الإجابة الصحيحة واختبر سرعة عقلك.</p>
      </div>
      <button class="play" onclick="startGame('math')">
        العب الآن
      </button>
    </div>

    <div class="card">
      <div>
        <div class="icon">🎯</div>
        <h3>خمن الرقم</h3>
        <p>هل تستطيع معرفة الرقم السري؟</p>
      </div>
      <button class="play" onclick="startGame('guess')">
        العب الآن
      </button>
    </div>

  </div>
</section>

<section class="game-area" id="gameArea">

  <div class="game-box">

    <button class="back" onclick="closeGame()">
      ← العودة للألعاب
    </button>

    <h2 id="gameTitle"></h2>

    <div id="gameContent"></div>

  </div>

</section>

<footer>
  © 2026 ODDORA Games — جميع الحقوق محفوظة
</footer>

<script>

let timer;
let score = 0;
let secretNumber = 0;

function scrollToGames() {
  document.getElementById("games").scrollIntoView({
    behavior: "smooth"
  });
}

function startGame(type) {

  document.getElementById("games").style.display = "none";
  document.getElementById("gameArea").style.display = "block";

  if (type === "clicker") {
    clickerGame();
  }

  if (type === "math") {
    mathGame();
  }

  if (type === "guess") {
    guessGame();
  }

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}

function closeGame() {

  clearInterval(timer);

  document.getElementById("gameArea").style.display = "none";
  document.getElementById("games").style.display = "block";

  scrollToGames();
}

function clickerGame() {

  clearInterval(timer);

  score = 0;
  let time = 10;

  document.getElementById("gameTitle").innerText =
    "⚡ اضغط بسرعة";

  document.getElementById("gameContent").innerHTML = `

    <div class="score">
      النقاط: <span id="score">0</span>
    </div>

    <div class="score">
      الوقت: <span id="time">10</span>
    </div>

    <button class="big-button" id="clickButton">
      اضغط!
    </button>

    <p id="result"></p>
  `;

  document.getElementById("clickButton").onclick = function() {

    if (time > 0) {
      score++;
      document.getElementById("score").innerText = score;
    }

  };

  timer = setInterval(function() {

    time--;

    document.getElementById("time").innerText = time;

    if (time <= 0) {

      clearInterval(timer);

      document.getElementById("clickButton").disabled = true;

      document.getElementById("result").innerHTML =
        "<h3>انتهى الوقت!</h3><p>نتيجتك: " +
        score +
        " نقطة</p>";
    }

  },1000);
}

function mathGame() {

  let a = Math.floor(Math.random() * 20) + 1;
  let b = Math.floor(Math.random() * 20) + 1;

  let correct = a + b;

  let answers = [
    correct,
    correct + Math.floor(Math.random()*6)+1,
    correct - Math.floor(Math.random()*5)-1,
    correct + 10
  ];

  answers.sort(() => Math.random() - .5);

  document.getElementById("gameTitle").innerText =
    "🧠 اختبار الرقم";

  document.getElementById("gameContent").innerHTML = `

    <div class="number">
      ${a} + ${b} = ?
    </div>

    <div id="answers"></div>

    <p id="mathResult"></p>
  `;

  const box = document.getElementById("answers");

  answers.forEach(function(answer) {

    const button = document.createElement("button");

    button.className = "answer";
    button.innerText = answer;

    button.onclick = function() {

      if (answer === correct) {

        document.getElementById("mathResult").innerHTML =
          "✅ إجابة صحيحة!";

      } else {

        document.getElementById("mathResult").innerHTML =
          "❌ إجابة خاطئة. الرقم الصحيح هو " + correct;
      }

    };

    box.appendChild(button);

  });
}

function guessGame() {

  secretNumber = Math.floor(Math.random() * 100) + 1;

  document.getElementById("gameTitle").innerText =
    "🎯 خمن الرقم";

  document.getElementById("gameContent").innerHTML = `

    <p>
      اختر رقمًا بين 1 و100
    </p>

    <input
      id="guessInput"
      type="number"
      min="1"
      max="100"
      placeholder="اكتب الرقم"
      style="
        padding:14px;
        border-radius:12px;
        border:0;
        margin:20px;
        width:200px;
        text-align:center;
        font-size:18px;
      "
    >

    <br>

    <button
      class="play"
      style="max-width:250px"
      onclick="checkGuess()"
    >
      تحقق
    </button>

    <p id="guessResult" style="margin-top:20px"></p>
  `;
}

function checkGuess() {

  const value =
    Number(document.getElementById("guessInput").value);

  const result =
    document.getElementById("guessResult");

  if (!value) {
    result.innerText = "اكتب رقمًا أولًا.";
    return;
  }

  if (value === secretNumber) {

    result.innerHTML =
      "🎉 ممتاز! لقد وجدت الرقم السري!";

  } else if (value < secretNumber) {

    result.innerText =
      "الرقم السري أكبر.";

  } else {

    result.innerText =
      "الرقم السري أصغر.";
  }
}

</script>

</body>
</html>
